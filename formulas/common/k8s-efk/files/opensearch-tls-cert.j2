apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: selfsigned-issuer
spec:
  selfSigned: {}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: opensearch-tls
  namespace: {{ pillar.get('efk_namespace', 'efk') }}
spec:
  secretName: opensearch-tls-secret
  issuerRef:
    name: selfsigned-issuer
    kind: ClusterIssuer
  commonName: {{ pillar.get('opensearch_service_host', 'opensearch.opensearch.svc.cluster.local') }}
  dnsNames:
    - {{ pillar.get('opensearch_service_host', 'opensearch.opensearch.svc.cluster.local') }}
    - {{ pillar.get('opensearch_service_host', 'opensearch.opensearch.svc.cluster.local') }}:{{ pillar.get('opensearch_service_port', 9200) }}
  usages:
    - server auth
    - client auth
  duration: 2160h  # 90 days
  renewBefore: 360h  # 15 days before expiration