# Default values for OpenSearch Helm chart
replicas: {{ pillar.get('opensearch_replicas', 3) }}

config:
  opensearch.yml: |
    cluster.name: {{ pillar.get('opensearch_cluster_name', 'opensearch-cluster') }}
    network.host: 0.0.0.0
    discovery.type: multi-node
    plugins.security.ssl.transport.enabled: true
    plugins.security.ssl.http.enabled: true
    plugins.security.allow_unsafe_democertificates: true  # For testing; set to false in production

securityConfig:
  enabled: true
  path: "/usr/share/opensearch/config/opensearch-security"
  config:
    securityConfigSecret: opensearch-security-config
  tls:
    transport:
      generate: true  # Auto-generate TLS certs for node-to-node
      perNode: true
    http:
      generate: true  # Auto-generate TLS certs for HTTP
extraEnvs:
  - name: OPENSEARCH_INITIAL_ADMIN_PASSWORD
    value: {{ pillar.get('opensearch_admin_password', 'YourStrongPassword123!') }}
  - name: DISABLE_INSTALL_DEMO_CONFIG
    value: "true"
roles:
  - master
  - data
  - ingest
resources:
  limits:
    cpu: {{ pillar.get('opensearch_cpu_limit', '1000m') }}
    memory: {{ pillar.get('opensearch_memory_limit', '1024Mi') }}
  requests:
    cpu: {{ pillar.get('opensearch_cpu_request', '500m') }}
    memory: {{ pillar.get('opensearch_memory_request', '512Mi') }}
persistence:
  enabled: {{ pillar.get('opensearch_persistence_enabled', true) }}
  size: {{ pillar.get('opensearch_persistence_size', '10Gi') }}
service:
  type: {{ pillar.get('opensearch_service_type', 'ClusterIP') }}