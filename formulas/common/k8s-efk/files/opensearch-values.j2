# Default values for OpenSearch Helm chart
replicas: {{ pillar.get('opensearch_replicas', 3) }}
config:
  opensearch.yml: |
    cluster.name: {{ pillar.get('opensearch_cluster_name', 'opensearch-cluster') }}
    network.host: 0.0.0.0
    plugins:
      security:
        allow_default_init_securityindex: true
        restapi:
          roles_enabled: ["all_access", "security_rest_api_access"]
        system_indices:
          enabled: true
          indices:
            - ".opensearch-alerting-config"
            - ".opensearch-alerting-alert*"
            - ".opensearch-anomaly-results*"
            - ".opensearch-anomaly-detector*"
            - ".opensearch-anomaly-checkpoints"
            - ".opensearch-anomaly-detection-state"
            - ".opensearch-reports-*"
            - ".opensearch-notifications-*"
            - ".opensearch-notebooks"
            - ".opensearch-asynchronous-search-response*"
        ssl:
          transport:
            enabled: {{ pillar.get('opensearch_transport_tls_enabled', true) }}
            pemcert_filepath: certs/tls.crt
            pemkey_filepath: certs/tls.key
            pemtrustedcas_filepath: certs/ca.crt
            enforce_hostname_verification: {{ pillar.get('opensearch_transport_ssl_hostname_verification', false) }}
          http:
            enabled: true
            pemcert_filepath: certs/tls.crt
            pemkey_filepath: certs/tls.key
            pemtrustedcas_filepath: certs/ca.crt
            enabled_ciphers:
              - "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
              - "TLS_ECDHE_ECDSA_WITH_AES_256_ GCM_SHA384"
              - "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"
              - "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384"
            enabled_protocols:
              - "TLSv1.2"
            clientauth_mode: OPTIONAL
        nodes_dn:
          - "CN={{ pillar.get('opensearch_service_host') }}.{{ pillar.get('efk_namespace') }}.svc.cluster.local"  # Match the commonName from the certificate
          - "CN={{ pillar.get('opensearch_service_host') }}"
          - "CN={{ pillar.get('opensearch_service_host') }}-headless"
          - "CN={{ pillar.get('opensearch_service_host') }}.{{ pillar.get('efk_namespace') }}.svc.cluster.local:{{ pillar.get('opensearch_service_port', 9200) }}"


securityConfig:
  enabled: true
  path: "/usr/share/opensearch/config/opensearch-security"
  internalUsersSecret: {{ pillar.get('opensearch_security_secrets', {}).get('internal_users', 'internal-users-secret') }}
  rolesSecret: {{ pillar.get('opensearch_security_secrets', {}).get('roles', 'roles-secret') }}
  rolesMappingSecret: {{ pillar.get('opensearch_security_secrets', {}).get('roles_mapping', 'roles-mapping-secret') }}
  actionGroupsSecret: {{ pillar.get('opensearch_security_secrets', {}).get('action_groups', 'action-groups-secret') }}
  configSecret: {{ pillar.get('opensearch_security_secrets', {}).get('config', 'config-secret') }}
  tenantsSecret: {{ pillar.get('opensearch_security_secrets', {}).get('tenants', 'tenants-secret') }}
tls:
  enabled: true
  secretName: "opensearch-tls-secret"  # Reference the secret created by Cert-Manager
  transport:
    enabled: true
    secretName: "opensearch-tls-secret"  # Same secret for transport layer TLS
extraVolumes:
  - name: opensearch-tls-secret
    secret:
      secretName: opensearch-tls-secret
  - name: security-config-dir
    emptyDir: {}
extraVolumeMounts:
  - name: opensearch-tls-secret
    mountPath: /usr/share/opensearch/config/certs
    readOnly: true
  - name: security-config-dir
    mountPath: "/usr/share/opensearch/config/opensearch-security"
extraEnvs:
  - name: OPENSEARCH_INITIAL_ADMIN_PASSWORD
    value: {{ pillar.get('opensearch_admin_password', 'YourStrongPassword123!') }}
  - name: DISABLE_INSTALL_DEMO_CONFIG
    value: "true"
  - name: OPENSEARCH_JAVA_OPTS
    value: "-Xms16000m -Xmx16000m"
roles:
  - master
  - data
  - ingest
resources:
  limits:
    cpu: {{ pillar.get('opensearch_cpu_limit', '4000m') }}
    memory: {{ pillar.get('opensearch_memory_limit', '8192Mi') }}
  requests:
    cpu: {{ pillar.get('opensearch_cpu_request', '2000m') }}
    memory: {{ pillar.get('opensearch_memory_request', '4094Mi') }}
persistence:
  enabled: {{ pillar.get('opensearch_persistence_enabled', true) }}
  size: {{ pillar.get('opensearch_persistence_size', '10Gi') }}
service:
  type: {{ pillar.get('opensearch_service_type', 'ClusterIP') }}