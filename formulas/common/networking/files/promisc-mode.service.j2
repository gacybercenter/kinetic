[Unit]
Description=Enable promiscuous mode on network bridges and bonds
After=network.target netplan-apply.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c '
echo "=== Enabling promiscuous mode on network interfaces ==="
{%- for network in pillar['hosts'][grains['type']]['networks'] if salt['pillar.get']('hosts:'+grains['type']+':networks:'+network+':managed', True) == True and network != "management" %}
echo "Setting promiscuous mode on {{ network }}_br"
ip link set "{{ network }}_br" promisc on 2>/dev/null || true
  {%- if salt['pillar.get']('hosts:'+grains['type']+':networks:'+network+':interfaces') | length > 1 %}
echo "Setting promiscuous mode on bond-{{ network }}"
ip link set "bond-{{ network }}" promisc on 2>/dev/null || true
  {%- endif %}
{%- endfor %}
echo "Promiscuous mode configuration complete"
'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
