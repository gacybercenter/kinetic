#!jinja|gpg|yaml

apiVersion: v1
kind: Service
metadata:
    name: ironic
    namespace: {{ pillar['bmo_namespace'] }}
spec:
    selector:
        name: ironic
    ports:
      - protocol: TCP
        name: ironic
        port: 6385
        targetPort: 6385
      - protocol: TCP
        name: ironic-dnsmasq
        port: 67
        targetPort: 67
    type: LoadBalancer
    loadBalancerIP: {{ pillar['ironic_endpoint_ip'] }}