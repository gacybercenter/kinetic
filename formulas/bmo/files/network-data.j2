{% set subnet_cidr = pillar['networking']['subnets']['management'].split('/')[1] %}
{% set netmask_result = salt['network_utils.cidr_to_netmask'](subnet_cidr) %}
{
  "links": [
    {
      "id": "{{ interface }}",
      "type": "phy",
      "ethernet_mac_address": "{{ mac }}"
    }
  ],
  "networks": [
    {
      "id": "{{ interface }}",
      "link": "{{ interface }}",
      "type": "ipv4",
      "ip_address": "{{ ip }}",
      "netmask": "{{ netmask_result }}",
      "gateway": "{{ gateway }}"
    }
  ],
  "services": [
    {
      "type": "dns",
      "address": "{{ nameserver }}"
    }
  ]
}