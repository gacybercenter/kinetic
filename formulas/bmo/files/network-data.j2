{% set type = grains['type'] %}
{
  "links": [
    {
      "id": "{{ pillar['hosts'][type]['interface'] }}",
      "type": "phy",
      "ethernet_mac_address": "{{ mac }}"
    }
  ],
  "networks": [
    {
      "id": "{{ pillar['hosts'][type]['interface'] }}",
      "link": "{{ pillar['hosts'][type]['interface'] }}",
      "type": "ipv4",
      "ip_address": "{{ ip }}",
      "netmask": "{{ prefix }}",
      "gateway": "{{ gateway }}"
    }
  ],
  "services": [
    {
      "type": "dns",
      "address": "{{ nameserver }}"
    }
  ]
}